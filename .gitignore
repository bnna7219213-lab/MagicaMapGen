# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Unity generated -- never commit. Library re-imports the whole PackageCache, and
# LowPolyWorldOutput holds batch-generated scenes/prefabs (533 MB on this machine).
# The .meta files under Assets/ and Packages/ ARE tracked on purpose: Unity needs
# them to keep asset identity stable across clones.
**/Library/
**/Temp/
**/Obj/
**/Build/
**/Builds/
**/Logs/
**/UserSettings/
**/LowPolyWorldOutput/
*.csproj
*.sln
*.user

# MagicaMapGen runtime workdir and the Unity batch log
tools/MagicaMapGen/_mmg_work/
unity_import.log

# Scratch output from ad-hoc verification runs
_pg/
_pg.jsonl
map_import_smoke/
_tmp_*/

# Debug dump written when eyeballing a generated frame
tools/MagicaMapGen/assets/skins/_preview_*.png

# Generated example outputs are regenerated by the README commands and are
# intentionally tracked: deliverable/ map_out/ island_out/
# Promo video is a 33 MB build artifact; regenerate with:
#   python tools/MagicaMapGen/tools/collect_promo_assets.py
#   python tools/MagicaMapGen/tools/promo_render.py
tools/MagicaMapGen/tools/*.mp4
tools/MagicaMapGen/tools/_promo_assets/
_promo_preview/
_clonetest/
